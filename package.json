{
  "name": "open-parcels-extension",
  "version": "0.3.0",
  "private": true,
  "description": "Companion browser extension for the open-parcels web UI: catches phone-app sign-in redirects.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build && npm run lint:firefox",
    "package": "npm run check && node scripts/release.mjs",
    "sign:firefox": "web-ext sign --source-dir dist/firefox --channel listed --upload-source-code release/open-parcels-extension-source-$npm_package_version.zip --artifacts-dir release/signed"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/webextension-polyfill": "^0.12.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "web-ext": "^8.0.0"
  }
}
